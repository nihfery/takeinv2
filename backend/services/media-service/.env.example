APP_ENV=local
SERVICE_VERSION=dev
HTTP_ADDR=127.0.0.1:18090
GRPC_ADDR=127.0.0.1:19090
METRICS_ADDR=127.0.0.1:20090
POSTGRES_DSN=postgres://takein_media:media_local_only@127.0.0.1:15432/takein_media?sslmode=disable
KAFKA_BROKERS=127.0.0.1:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=
REDIS_DB=0
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
JWT_ISSUER=https://identity.takein.local
JWT_AUDIENCE=takein-api
JWT_PUBLIC_KEY_FILE=../../infra/secrets/local/jwt-public.pem
INTERNAL_GRPC_TOKEN=local_only_internal_grpc_token_change_me
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=auto
S3_BUCKET=takein-private
S3_ACCESS_KEY_ID=local-access
S3_SECRET_ACCESS_KEY=local-secret
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
