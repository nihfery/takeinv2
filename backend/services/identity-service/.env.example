APP_ENV=local
SERVICE_VERSION=dev
HTTP_ADDR=127.0.0.1:18081
GRPC_ADDR=127.0.0.1:19081
METRICS_ADDR=127.0.0.1:20081
POSTGRES_DSN=postgres://takein_identity:identity_local_only@127.0.0.1:15432/takein_identity?sslmode=disable
KAFKA_BROKERS=127.0.0.1:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=
REDIS_DB=0
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
JWT_ISSUER=https://identity.takein.local
JWT_AUDIENCE=takein-api
JWT_KEY_ID=local-development
JWT_PRIVATE_KEY_FILE=../../infra/secrets/local/jwt-private.pem
JWT_PUBLIC_KEY_FILE=../../infra/secrets/local/jwt-public.pem
INTERNAL_GRPC_TOKEN=local_only_internal_grpc_token_change_me
RATE_LIMIT_REGISTER=1000
RATE_LIMIT_LOGIN=1000
RATE_LIMIT_REFRESH=1000
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
