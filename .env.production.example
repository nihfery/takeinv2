# TakeIn production Go/Next runtime. Resolve every placeholder through the
# orchestrator or secret manager; do not commit a populated copy.
TAKEIN_APP_ENV=production
TAKEIN_SERVICE_VERSION=replace_with_immutable_commit_sha
TAKEIN_LOG_LEVEL=info
TAKEIN_PUBLIC_API_URL=https://api.takein.id
TAKEIN_COOKIE_SECURE=true
TAKEIN_CORS_ALLOWED_ORIGINS=https://takein.id,https://partners.takein.id,https://provider.takein.id,https://admin.takein.id

PROVIDER_FRONTEND_URL=https://partners.takein.id
CUSTOMER_FRONTEND_URL=https://takein.id
PROVIDER_CONSOLE_URL=https://provider.takein.id
ADMIN_FRONTEND_URL=https://admin.takein.id

TAKEIN_IDENTITY_POSTGRES_DSN=postgres://takein_identity:replace_from_secret_manager@postgres.example.invalid:5432/takein_identity?sslmode=verify-full
TAKEIN_CUSTOMER_POSTGRES_DSN=postgres://takein_customer:replace_from_secret_manager@postgres.example.invalid:5432/takein_customer?sslmode=verify-full
TAKEIN_PROVIDER_POSTGRES_DSN=postgres://takein_provider:replace_from_secret_manager@postgres.example.invalid:5432/takein_provider?sslmode=verify-full
TAKEIN_CATALOG_POSTGRES_DSN=postgres://takein_catalog:replace_from_secret_manager@postgres.example.invalid:5432/takein_catalog?sslmode=verify-full
TAKEIN_BOOKING_POSTGRES_DSN=postgres://takein_booking:replace_from_secret_manager@postgres.example.invalid:5432/takein_booking?sslmode=verify-full
TAKEIN_PAYMENT_POSTGRES_DSN=postgres://takein_payment:replace_from_secret_manager@postgres.example.invalid:5432/takein_payment?sslmode=verify-full
TAKEIN_BILLING_POSTGRES_DSN=postgres://takein_billing:replace_from_secret_manager@postgres.example.invalid:5432/takein_billing?sslmode=verify-full
TAKEIN_NOTIFICATION_POSTGRES_DSN=postgres://takein_notification:replace_from_secret_manager@postgres.example.invalid:5432/takein_notification?sslmode=verify-full
TAKEIN_CHAT_POSTGRES_DSN=postgres://takein_chat:replace_from_secret_manager@postgres.example.invalid:5432/takein_chat?sslmode=verify-full
TAKEIN_MEDIA_POSTGRES_DSN=postgres://takein_media:replace_from_secret_manager@postgres.example.invalid:5432/takein_media?sslmode=verify-full
TAKEIN_AUDIT_POSTGRES_DSN=postgres://takein_audit:replace_from_secret_manager@postgres.example.invalid:5432/takein_audit?sslmode=verify-full

TAKEIN_REDIS_ADDR=redis.example.invalid:6379
TAKEIN_REDIS_PASSWORD=replace_from_secret_manager
TAKEIN_REDIS_DB=0
TAKEIN_KAFKA_BROKERS=kafka-1.example.invalid:9093,kafka-2.example.invalid:9093,kafka-3.example.invalid:9093
TAKEIN_KAFKA_SECURITY_PROTOCOL=SASL_SSL
TAKEIN_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
TAKEIN_KAFKA_USERNAME=replace_from_secret_manager
TAKEIN_KAFKA_PASSWORD=replace_from_secret_manager
TAKEIN_KAFKA_TLS_CA_FILE=/run/takein-secrets/kafka-ca.pem
TAKEIN_KAFKA_TLS_SERVER_NAME=kafka.example.invalid

INTERNAL_GRPC_TOKEN=replace_from_secret_manager_at_least_32_chars
JWT_ISSUER=https://identity.takein.id
JWT_AUDIENCE=takein-api
TAKEIN_RUNTIME_SECRETS_SOURCE=/absolute/path/to/takein-runtime-secrets
JWT_PRIVATE_KEY_FILE=/run/takein-secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=/run/takein-secrets/jwt-public.pem
CHAT_WEBSOCKET_ORIGINS=https://takein.id,https://provider.takein.id,https://admin.takein.id

MIDTRANS_BASE_URL=https://app.midtrans.com
MIDTRANS_SERVER_KEY=replace_from_secret_manager
MIDTRANS_CLIENT_KEY=replace_from_secret_manager
S3_ENDPOINT=https://replace_with_account_id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=replace_with_private_bucket
S3_ACCESS_KEY_ID=replace_from_secret_manager
S3_SECRET_ACCESS_KEY=replace_from_secret_manager
S3_PUBLIC_BASE_URL=https://assets.takein.id
TAKEIN_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.invalid
