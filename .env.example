# TakeIn local Go/Next runtime
TAKEIN_APP_ENV=local
TAKEIN_SERVICE_VERSION=dev
TAKEIN_LOG_LEVEL=debug
TAKEIN_PUBLIC_API_URL=http://127.0.0.1:8088
TAKEIN_COOKIE_SECURE=false
TAKEIN_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176

PROVIDER_FRONTEND_URL=http://127.0.0.1:5173
CUSTOMER_FRONTEND_URL=http://127.0.0.1:5174
PROVIDER_CONSOLE_URL=http://127.0.0.1:5175
ADMIN_FRONTEND_URL=http://127.0.0.1:5176
PROVIDER_LANDING_PORT=5173
CUSTOMER_WEB_PORT=5174
PROVIDER_CONSOLE_PORT=5175
ADMIN_WEB_PORT=5176

TAKEIN_POSTGRES_PORT=15432
TAKEIN_POSTGRES_ADMIN_PASSWORD=takein_local_admin_only
TAKEIN_IDENTITY_DB_USER=takein_identity
TAKEIN_IDENTITY_DB_PASSWORD=identity_local_only
TAKEIN_CUSTOMER_DB_USER=takein_customer
TAKEIN_CUSTOMER_DB_PASSWORD=customer_local_only
TAKEIN_PROVIDER_DB_USER=takein_provider
TAKEIN_PROVIDER_DB_PASSWORD=provider_local_only
TAKEIN_CATALOG_DB_USER=takein_catalog
TAKEIN_CATALOG_DB_PASSWORD=catalog_local_only
TAKEIN_BOOKING_DB_USER=takein_booking
TAKEIN_BOOKING_DB_PASSWORD=booking_local_only
TAKEIN_PAYMENT_DB_USER=takein_payment
TAKEIN_PAYMENT_DB_PASSWORD=payment_local_only
TAKEIN_BILLING_DB_USER=takein_billing
TAKEIN_BILLING_DB_PASSWORD=billing_local_only
TAKEIN_NOTIFICATION_DB_USER=takein_notification
TAKEIN_NOTIFICATION_DB_PASSWORD=notification_local_only
TAKEIN_CHAT_DB_USER=takein_chat
TAKEIN_CHAT_DB_PASSWORD=chat_local_only
TAKEIN_MEDIA_DB_USER=takein_media
TAKEIN_MEDIA_DB_PASSWORD=media_local_only
TAKEIN_AUDIT_DB_USER=takein_audit
TAKEIN_AUDIT_DB_PASSWORD=audit_local_only

TAKEIN_REDIS_PORT=6380
TAKEIN_REDIS_ADDR=takein-redis:6379
TAKEIN_REDIS_PASSWORD=
TAKEIN_REDIS_DB=0
TAKEIN_KAFKA_PORT=29092
TAKEIN_KAFKA_BROKERS=takein-kafka:9092
TAKEIN_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
TAKEIN_KAFKA_MAX_RETRIES=10
TAKEIN_KAFKA_CONSUMER_MAX_RETRIES=5

INTERNAL_GRPC_TOKEN=local_only_internal_grpc_token_change_me
JWT_ISSUER=https://identity.takein.local
JWT_AUDIENCE=takein-api
TAKEIN_RUNTIME_SECRETS_SOURCE=./infra/secrets/local
JWT_PRIVATE_KEY_FILE=/run/takein-secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=/run/takein-secrets/jwt-public.pem
CHAT_WEBSOCKET_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176

MIDTRANS_BASE_URL=http://takein-midtrans-mock:8080
MIDTRANS_SERVER_KEY=local-midtrans-server-key
MIDTRANS_CLIENT_KEY=local-midtrans-client-key
S3_ENDPOINT=http://takein-object-storage:8080
S3_REGION=auto
S3_BUCKET=takein-private
S3_ACCESS_KEY_ID=local-access
S3_SECRET_ACCESS_KEY=local-secret
S3_PUBLIC_BASE_URL=http://127.0.0.1:19000/takein-private
TAKEIN_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
