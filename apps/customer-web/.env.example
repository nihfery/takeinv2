# Go edge and identity origins as seen by the Next.js server. Browser requests
# use the same-origin /api BFF so bearer and refresh tokens remain HttpOnly.
GO_API_BASE_URL=http://127.0.0.1:8088
GO_IDENTITY_URL=http://127.0.0.1:18081
TAKEIN_COOKIE_SECURE=false
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8088
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8088/api

# Local/demo fallback only. Production Docker builds default this to false so
# browser actions can never mark a payment paid without gateway verification.
NEXT_PUBLIC_ALLOW_MANUAL_PAYMENT_CONFIRMATION=true

# Optional legacy alias for server-side public catalog reads.
TAKEIN_DEMO_CATALOG_FALLBACK=true

# Cross-app links. Loopback hosts (127.0.0.1/localhost) are automatically rewritten
# on the client to the host the page was opened from, so these keep working when the
# site is accessed from another device on the local network.
NEXT_PUBLIC_PROVIDER_FRONTEND_URL=http://127.0.0.1:5173
NEXT_PUBLIC_CUSTOMER_APP_URL=http://127.0.0.1:5174
