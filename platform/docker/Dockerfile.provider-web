# syntax=docker/dockerfile:1.7
FROM node:22.23.1-alpine3.24

ARG NEXT_PUBLIC_PROVIDER_LOGIN_URL
ARG NEXT_PUBLIC_PROVIDER_CONSOLE_URL

ENV NEXT_PUBLIC_PROVIDER_LOGIN_URL=$NEXT_PUBLIC_PROVIDER_LOGIN_URL
ENV NEXT_PUBLIC_PROVIDER_CONSOLE_URL=$NEXT_PUBLIC_PROVIDER_CONSOLE_URL

WORKDIR /workspace/apps/provider-web

COPY apps/provider-web/package*.json ./

RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline --no-audit

COPY apps/provider-web/ ./

RUN node -e "process.stdout.write(require('node:crypto').randomUUID())" > /tmp/provider-web-deployment-id \
    && NEXT_DEPLOYMENT_ID="$(cat /tmp/provider-web-deployment-id)" npm run build \
    && cp /tmp/provider-web-deployment-id .next/DEPLOYMENT_ID \
    && rm -rf /usr/local/lib/node_modules/npm \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx

EXPOSE 5175

CMD ["sh", "-c", "NEXT_DEPLOYMENT_ID=\"$(cat .next/DEPLOYMENT_ID)\" exec node node_modules/next/dist/bin/next start -H 0.0.0.0 -p 5175"]
