# syntax=docker/dockerfile:1.7
FROM node:22.23.1-alpine3.24

ARG APP_PATH

ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_PROVIDER_FRONTEND_URL
ARG NEXT_PUBLIC_PROVIDER_CONSOLE_URL
ARG NEXT_PUBLIC_ADMIN_WEB_URL
ARG NEXT_PUBLIC_CUSTOMER_APP_URL
ARG NEXT_PUBLIC_PROVIDER_LOGIN_PATH
ARG NEXT_PUBLIC_PROVIDER_DASHBOARD_PATH
ARG NEXT_PUBLIC_PROVIDER_LOGIN_URL
ARG NEXT_PUBLIC_PROVIDER_DASHBOARD_URL
ARG NEXT_PUBLIC_PROVIDER_VERIFICATION_URL
ARG NEXT_PUBLIC_PROVIDER_LANDING_URL
ARG NEXT_PUBLIC_ALLOW_MANUAL_PAYMENT_CONFIRMATION=false
ARG GO_API_BASE_URL
ARG GO_IDENTITY_URL
ARG TAKEIN_COOKIE_SECURE=false

ARG VITE_BACKEND_URL
ARG VITE_API_BASE_URL
ARG VITE_PROVIDER_LOGIN_PATH
ARG VITE_PROVIDER_DASHBOARD_PATH

ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_PROVIDER_FRONTEND_URL=$NEXT_PUBLIC_PROVIDER_FRONTEND_URL
ENV NEXT_PUBLIC_PROVIDER_CONSOLE_URL=$NEXT_PUBLIC_PROVIDER_CONSOLE_URL
ENV NEXT_PUBLIC_ADMIN_WEB_URL=$NEXT_PUBLIC_ADMIN_WEB_URL
ENV NEXT_PUBLIC_CUSTOMER_APP_URL=$NEXT_PUBLIC_CUSTOMER_APP_URL
ENV NEXT_PUBLIC_PROVIDER_LOGIN_PATH=$NEXT_PUBLIC_PROVIDER_LOGIN_PATH
ENV NEXT_PUBLIC_PROVIDER_DASHBOARD_PATH=$NEXT_PUBLIC_PROVIDER_DASHBOARD_PATH
ENV NEXT_PUBLIC_PROVIDER_LOGIN_URL=$NEXT_PUBLIC_PROVIDER_LOGIN_URL
ENV NEXT_PUBLIC_PROVIDER_DASHBOARD_URL=$NEXT_PUBLIC_PROVIDER_DASHBOARD_URL
ENV NEXT_PUBLIC_PROVIDER_VERIFICATION_URL=$NEXT_PUBLIC_PROVIDER_VERIFICATION_URL
ENV NEXT_PUBLIC_PROVIDER_LANDING_URL=$NEXT_PUBLIC_PROVIDER_LANDING_URL
ENV NEXT_PUBLIC_ALLOW_MANUAL_PAYMENT_CONFIRMATION=$NEXT_PUBLIC_ALLOW_MANUAL_PAYMENT_CONFIRMATION
ENV GO_API_BASE_URL=$GO_API_BASE_URL
ENV GO_IDENTITY_URL=$GO_IDENTITY_URL
ENV TAKEIN_COOKIE_SECURE=$TAKEIN_COOKIE_SECURE

ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_PROVIDER_LOGIN_PATH=$VITE_PROVIDER_LOGIN_PATH
ENV VITE_PROVIDER_DASHBOARD_PATH=$VITE_PROVIDER_DASHBOARD_PATH

WORKDIR /app

COPY ${APP_PATH}/package*.json ./

RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then npm ci --prefer-offline --no-audit; else npm install --prefer-offline --no-audit; fi

COPY ${APP_PATH}/ ./

RUN npm run build \
    && rm -rf /usr/local/lib/node_modules/npm \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx

EXPOSE 3000
EXPOSE 5174
EXPOSE 5175
EXPOSE 5176

CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0"]
